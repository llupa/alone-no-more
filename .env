# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/ai-anthropic-platform ###
ANTHROPIC_API_KEY=
###< symfony/ai-anthropic-platform ###

###> alone-no-more ###
# AzerothCore SOAP interface (worldserver.conf: SOAP.Enabled=1, binds to 127.0.0.1 by default).
# The account needs a GM level high enough for the commands we send.
# The GM account the app uses to reach the console. Deliberately EMPTY here: .env is committed,
# and this account can create accounts and ban players. Put yours in .env.local, which is not.
# Create one on your server with:  account create <name> <password>  /  account set gmlevel <name> 3 -1
ANM_SOAP_ENDPOINT=http://127.0.0.1:7878/
ANM_SOAP_USERNAME=
ANM_SOAP_PASSWORD=
# mod-playerbots command server (playerbots.conf: Playerbots.CommandServerPort).
ANM_COMMAND_SERVER_HOST=127.0.0.1
ANM_COMMAND_SERVER_PORT=8888
# AzerothCore databases. Port 3307 locally because 3306 is taken by another project.
ANM_CHARACTERS_DSN=mysql://acore:acore@127.0.0.1:3307/acore_characters
ANM_WORLD_DSN=mysql://acore:acore@127.0.0.1:3307/acore_world
###< alone-no-more ###

###> alone-no-more: AI ###
# "ollama" (local, free, no key) or "anthropic" (better dialogue, needs a key + credits).
ANM_AI_PROVIDER=ollama
OLLAMA_ENDPOINT=http://127.0.0.1:11434
ANM_OLLAMA_MODEL=llama3.1:8b
# The performer: in-character replies. Quality shows directly in the demo.
ANM_ANTHROPIC_MODEL=claude-sonnet-5-5
# The archivist: reads database rows, writes a sentence. Cheap by design.
ANM_LORE_MODEL=claude-haiku-5-5
###< alone-no-more: AI ###
# How many levels apart a bot may be from the player and still plausibly belong in the scene.
ANM_PEER_LEVEL_TOLERANCE=5
# Our own store — conversation history and bot affinity. Never written to AzerothCore's schema.
ANM_STORE_PATH=%kernel.project_dir%/var/anm.sqlite
# How many past lines of a conversation a bot carries into its next reply.
ANM_MEMORY_EXCHANGES=6
# Seconds a bot stays quiet after speaking, so one voice cannot dominate a party.
ANM_BOT_COOLDOWN_SECONDS=20
# Cooldown when a bot is the only one who could answer — a lone companion must not ignore you.
ANM_SOLE_BOT_COOLDOWN_SECONDS=3
# Client data tables (AreaTable.dbc etc). Shipped with the server's data directory, not this repo.
ANM_DBC_DIR=/Users/stivenllupa/wow/server/data/dbc
# Turns of conversation a bot keeps hot per player — about half theirs, half yours.
ANM_HOT_MEMORY_MESSAGES=20
# Companion lines a bot is told it overheard. Only what it missed while another bot answered,
# so this stays small — the bot's own exchanges arrive as conversation turns, not as memory.
ANM_SCENE_MEMORY_LINES=6
# How long to let a companion finish one fight before pointing it at the next. Too short and it
# abandons a half-killed wolf to run at a fresh one.
ANM_ERRAND_SWING_SECONDS=8
# One `go` is not enough: the follow strategy pulls a companion back, so the destination is
# re-sent on this interval until they arrive.
# Ambient muttering. /say carries about 25 yards, and with fifty bots in earshot the interval is
# the only thing between flavour and a wall of text. Raise it if the world gets chatty.
# Must match Playerbots.CommandPrefix in playerbots.conf. With a prefix set, the mod ignores any
# chat line that does not start with it — so "Do you have quests?" stops being parsed as the
# action `you have quests?`, and mentioning "cloth" stops opening a trade window. Our own orders
# go through the same gate, so they carry it too.
ANM_BOT_COMMAND_PREFIX=!

ANM_BANTER_RADIUS=25
ANM_BANTER_SECONDS=180
# How long a conversation stays with the bot already in it, before rotation resumes.
ANM_STICKY_SECONDS=90
# How many bots should be around you, and how far "around" reaches.
ANM_HERD_TARGET=50
ANM_HERD_RADIUS=600
# Herding cadence. A zone change must hold this long before we believe it.
ANM_HERD_SETTLE_SECONDS=60
ANM_HERD_REFRESH_SECONDS=180
ANM_HERD_DISMISS_BEYOND=1200
ANM_HERD_PROTECT_SPOKEN_WITHIN=600
# Seconds to let a bot finish logging in before giving it orders.
ANM_HERD_ROUSE_DELAY_SECONDS=10
