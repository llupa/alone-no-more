  "cards": [
    {
      "dot": "cyan",
      "title": "Why a C++ module at all",
      "items": [
        "The core logs chat joins and leaves, never message bodies \u2014 there is no log to tail.",
        "Every route out of the mod is leashed to 150 yards, so leading someone had to move inside."
      ]
    },
    {
      "dot": "emerald",
      "title": "Grounded, deliberately",
      "items": [
        "A cheap archivist reads the tables; the companion never sees a raw row.",
        "Quest progress, loot, zones and who is alive all come from the server's own data."
      ]
    },
    {
      "dot": "violet",
      "title": "Runs without any of this",
      "items": [
        "APP_ENV=replay swaps every gateway for a recorded world in fixtures/.",
        "No AzerothCore, no MySQL, no client, no API key."
      ]
    }
  ]
